  "openclaw": {
    "name": "OpenClaw远程Agent",
    "description": "OpenClaw Agent远程服务",
    "tool_class": "OpenClawTool",
    "category": "agent",
    "requires_config": true,
    "version": "1.0.0",
    "enabled": true,
    "parameters": {
      "server_url": {"type": "string", "description": "OpenClaw Gateway 地址", "required": true},
      "api_key": {"type": "string", "description": "OpenClaw API Key", "sensitive": true, "required": true}
    }
  },
  "database": {
    "name": "数据库查询",
    "description": "PostgreSQL 数据库工具：无需预先配置任何连接信息，启用后 Agent/工作流调用时需自行提供数据库连接信息（host/port/user/password）、要操作的 database 和 sql，可执行任意 SQL（包含写操作/DDL，不做限制），请谨慎使用",
    "tool_class": "DatabaseTool",
    "category": "data",
    "requires_config": false,
    "version": "1.0.0",
    "enabled": true,
    "parameters": {}
  },
  "mineru": {
    "name": "MinerU 文档解析",
    "description": "MinerU 私有化部署的 PDF/文档解析工具,走 V3 异步 /tasks 协议(与 RAG 解析管道同源),供工作流文档提取器节点使用。注意:工具不返回抽取的图片。",
    "tool_class": "MinerUTool",
    "category": "extractor",
    "requires_config": true,
    "version": "1.0.0",
    "enabled": true,
    "parameters": {
      "api_url": {"type": "string", "description": "MinerU 服务基础地址,例如 http://183.147.142.122:18000,内部复用 MinerUV3Client 走异步 /tasks 协议(提交任务 → 轮询 → 拉取结果)", "required": true},
      "api_key": {"type": "string", "description": "当前 MinerUV3Client 不支持鉴权,该项暂未使用,保留为占位配置", "sensitive": true, "required": false}
    }
  }
}