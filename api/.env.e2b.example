# ============================================================
# E2B Sandbox Configuration
# 将以下配置追加到你的 .env 文件中以启用 E2B sandbox 执行
# ============================================================

# 全局开关：启用/禁用 E2B sandbox 执行
# true = Agent/Workflow 在 sandbox 中执行
# false = 保持原有 in-process 执行（默认）
E2B_ENABLED=false

# 自建 E2B Orchestrator 地址
E2B_ORCHESTRATOR_URL=http://e2b-orchestrator:3001

# Orchestrator API 认证密钥
E2B_ORCHESTRATOR_SECRET=your-secure-secret-here

# Sandbox 模板名称（对应 e2b-infra/templates/ 中构建的模板）
E2B_TEMPLATE_ID=agent-runtime

# Sandbox 默认超时（秒）
E2B_SANDBOX_TIMEOUT=300

# Sandbox 资源配置
E2B_SANDBOX_CPU=2
E2B_SANDBOX_MEMORY_MB=512

# Sandbox 回调地址（sandbox 内的工具需要回调主 API）
# 必须是 sandbox 容器能访问到的地址
E2B_CALLBACK_URL=http://api:8000

# Sandbox 回调认证密钥
E2B_CALLBACK_SECRET=sandbox-callback-secret
