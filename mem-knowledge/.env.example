# mem-knowledge 本地配置示例：复制为 .env，按实际环境填写地址、路径和凭据。
# 优先级：进程环境变量 > 服务 .env > 根目录 .env > 默认值；修改后重启进程。
# 复用根目录配置时，删除或注释对应配置行，空值也会覆盖根目录的同名值。
# API 与 Worker 使用相同的数据库、存储和消息代理；启动命令需与角色对应。

# 服务信息与日志；监听地址和端口由 Uvicorn 启动参数决定。
DEPLOYMENT_MODE=community
KB_PROCESS_ROLE=api
KB_LOG_LEVEL=INFO
KB_HOST=0.0.0.0
KB_PORT=8080

# 启动前的进程环境变量（可选）：需通过 Shell 或容器注入，服务读取 .env 不会设置这些变量。
# 本地路径默认按源码位置推导；显式指定的配置文件必须存在，目录不可设为空。
# MEMORYBEAR_ROOT_DIR=/absolute/path/to/MemoryBear
# KB_SERVICE_DIR=/absolute/path/to/MemoryBear/mem-knowledge
# MEMORYBEAR_ROOT_ENV_FILE=
# KB_ENV_FILE=
# PYTHONDONTWRITEBYTECODE=1
# PYTHONUNBUFFERED=1
# TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache

# PostgreSQL 与连接池：回收和等待时间单位为秒，语句超时单位为毫秒。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=redbear-mem
KB_DB_POOL_SIZE=20
KB_DB_MAX_OVERFLOW=10
KB_DB_POOL_RECYCLE=1800
KB_DB_POOL_TIMEOUT=30
KB_DB_POOL_PRE_PING=true
KB_DB_STATEMENT_TIMEOUT_MS=60000

# Redis：业务缓存、锁和任务协调。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
KB_REDIS_POOL_SIZE=50

# Celery：URL 留空时使用下方 Redis 库；RabbitMQ 通过 CELERY_BROKER_URL 配置。
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_BACKEND=4
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Elasticsearch：HOST 带协议，端口单独设置；请求超时单位为秒。
ELASTICSEARCH_HOST=https://127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=REPLACE_WITH_ELASTICSEARCH_PASSWORD
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=100.0
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_RETRIES=10
KB_ES_CONNECTIONS_PER_NODE=10

# 文件存储：local / oss / s3 / minio；本地路径须绝对且可写，API 与 Worker 共享文件。
# FILE_LOCAL_SERVER_URL 是图片 Markdown 的公开地址前缀，留空使用相对地址。
STORAGE_TYPE=local
FILE_PATH=/files
FILE_LOCAL_SERVER_URL=

# OSS：选用时填写本组全部参数。
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# S3：选用时填写本组参数，ENDPOINT_URL 可留空使用区域默认地址。
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# MinIO：选用时填写本组参数，服务地址示例为 http://minio:9000。
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET_NAME=
MINIO_REGION=us-east-1

# 模型服务：填写内部地址；超时单位为秒，LLM 空闲超时按数据帧间隔计算。
# 同机调试时，model-service 与本服务需使用不同监听端口。
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8080
MODEL_SERVICE_POOL_TIMEOUT_SECONDS=5.0
MODEL_SERVICE_INVOKE_CONNECT_TIMEOUT_SECONDS=5.0
MODEL_SERVICE_INVOKE_IDLE_TIMEOUT_SECONDS=180.0
MODEL_SERVICE_INVOKE_WRITE_TIMEOUT_SECONDS=60.0
MODEL_SERVICE_INVOKE_MEDIA_IDLE_TIMEOUT_SECONDS=720.0
MODEL_SERVICE_MAX_CONNECTIONS=100
MODEL_SERVICE_MAX_KEEPALIVE_CONNECTIONS=20

# RAG 并发与批次：图谱投影和 QA 导入的向量化批次上限为 20；图谱检索超时单位为毫秒。
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_WORKERS=3
AUTO_QUESTIONS_MAX_WORKERS=5
KB_VISION_MAX_WORKERS=10
KNOWLEDGE_GRAPH_EXTRACT_MAX_CONCURRENCY=4
KNOWLEDGE_GRAPH_RETRIEVAL_TIMEOUT_MS=15000

# 处理限制：文件大小单位为字节，其余分别为批次条目数和文档页数。
MAX_FILE_SIZE=52428800
MAX_CHUNK_BATCH_SIZE=8
MAX_DOCUMENT_PAGES=200

# 解析服务：按文档或知识库配置选择；时间单位为秒，选用 TextIn 时填写凭据。
MINERU_V3_APISERVER=http://127.0.0.1:18000
MINERU_V3_REQUEST_TIMEOUT_SECONDS=600.0
MINERU_V3_POLL_INTERVAL_SECONDS=2.0
MINERU_V3_POLL_TIMEOUT_SECONDS=1800.0
TEXTLN_APISERVER=https://api.textin.com/ai/service/v1/pdf_to_markdown
TEXTLN_APP_ID=
TEXTLN_SECRET_CODE=
TEXTLN_REQUEST_TIMEOUT_SECONDS=600.0

# Office 解析工具：路径按实际安装位置填写，超时单位为秒。
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TIMEOUT_SECONDS=120.0
TIKA_SERVER_JAR=file:///opt/tika/tika-server-standard-3.1.0.jar

# 健康检查：超时单位为秒；状态文件须可写，同机多个 Worker 应使用不同路径。
KB_HEALTH_PROBE_TIMEOUT_SECONDS=3.0
KB_WORKER_HEALTH_STATE_FILE=/tmp/mem-knowledge-worker-health.json

# Worker：时间单位为秒，软超时须小于硬超时；角色与消费队列需对应。
# document_worker → document_tasks；graphrag_worker → graphrag_tasks；qa_import_worker → qa_import。
KB_WORKER_PREFETCH_MULTIPLIER=1
KB_TASK_HEARTBEAT_SECONDS=30.0
KB_PROGRESS_FLUSH_INTERVAL_SECONDS=3.0
KB_TASK_TIME_LIMIT_SECONDS=3600
KB_TASK_SOFT_TIME_LIMIT_SECONDS=3000
KB_RESULT_EXPIRES_SECONDS=3600

# 鉴权：direct 信任受网络策略保护的上游身份头；gateway 需要企业扩展和 JWKS 地址。
# 应急开关路径留空；若指定的文件存在，将绕过鉴权。
KB_AUTH_MODE=direct
KB_SERVICE_NAME=kb
KB_JWKS_URL=
KB_KILL_SWITCH_FILE=
# ACL 规则 key + 热更新频道（gateway 模式用）：留空则按
# acl:rules:<DB_NAME> / acl:rules:changed:<DB_NAME> 派生，须与身份服务一致
ACL_RULES_KEY=
ACL_RULES_CHANGED_CHANNEL=
