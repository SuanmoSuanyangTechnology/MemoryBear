# Shared environment variables.
# Bootstrap loads these from ../.env first; values in this file override the root file.
DEPLOYMENT_MODE=community

# PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=redbear-mem

# Redis and Celery.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_BACKEND=4
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Elasticsearch.
ELASTICSEARCH_HOST=https://127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=100
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_RETRIES=10

# Shared file storage. Configure only the selected STORAGE_TYPE backend.
STORAGE_TYPE=local
FILE_PATH=/files
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET_NAME=
MINIO_REGION=us-east-1

# Shared model runtime.
SPEEDBEAR_BASE_URL=https://testspeedbear.redbearai.com
SPEEDBEAR_AUTH_KEY=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_WORKERS=3
AUTO_QUESTIONS_MAX_WORKERS=5
KNOWLEDGE_GRAPH_EXTRACT_MAX_CONCURRENCY=4
KNOWLEDGE_GRAPH_RETRIEVAL_TIMEOUT_MS=15000
MODEL_CONCURRENCY=5
MODEL_HTTP_MAX_CONNECTIONS=300
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
MODEL_HTTP_TRUST_ENV=true
BEDROCK_MAX_POOL_CONNECTIONS=50
BEDROCK_MAX_RETRIES=2

# Knowledge service environment variables.
KB_HOST=0.0.0.0
KB_PORT=8080
KB_PROCESS_ROLE=api
KB_LOG_LEVEL=INFO

# Knowledge-owned database pools.
KB_DB_POOL_SIZE=20
KB_DB_MAX_OVERFLOW=10
KB_DB_POOL_RECYCLE=1800
KB_DB_POOL_TIMEOUT=30
KB_DB_POOL_PRE_PING=true
KB_DB_STATEMENT_TIMEOUT_MS=60000

# Service-local client limits.
KB_REDIS_POOL_SIZE=50
KB_ES_CONNECTIONS_PER_NODE=10
KB_VISION_MAX_WORKERS=10
KB_HEALTH_PROBE_TIMEOUT_SECONDS=3

# Parser services. MinerU and TextLn failures do not fall back to another parser.
MAX_DOCUMENT_PAGES=200
MINERU_V3_APISERVER=http://127.0.0.1:18000
MINERU_V3_REQUEST_TIMEOUT_SECONDS=600
MINERU_V3_POLL_INTERVAL_SECONDS=2
MINERU_V3_POLL_TIMEOUT_SECONDS=1800
TEXTLN_APISERVER=https://api.textin.com/ai/service/v1/pdf_to_markdown
TEXTLN_APP_ID=
TEXTLN_SECRET_CODE=
TEXTLN_REQUEST_TIMEOUT_SECONDS=600

# Office and legacy .doc runtime artifacts.
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TIMEOUT_SECONDS=120
TIKA_SERVER_JAR=file:///opt/tika/tika-server-standard-3.1.0.jar
TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache

# Public file URL prefix used in generated image Markdown. Empty keeps relative URLs.
FILE_LOCAL_SERVER_URL=

# Audio and video model. The API key is intentionally blank by default.
QWEN3_OMNI_API_KEY=
QWEN3_OMNI_MODEL_NAME=qwen3-omni-flash
QWEN3_OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Worker defaults. Deployment commands override concurrency and queue.
KB_WORKER_PREFETCH_MULTIPLIER=1
KB_TASK_TIME_LIMIT_SECONDS=3600
KB_TASK_SOFT_TIME_LIMIT_SECONDS=3000
KB_RESULT_EXPIRES_SECONDS=3600

# One image supports four startup roles. Pool and concurrency remain command overrides.
# API: KB_PROCESS_ROLE=api uvicorn src.main:app --host 0.0.0.0 --port 8080
# Document: KB_PROCESS_ROLE=document_worker celery -A src.tasks.celery_worker:celery_app worker --pool=prefork --queues=document_tasks
# Graph: KB_PROCESS_ROLE=graphrag_worker celery -A src.tasks.celery_worker:celery_app worker --pool=prefork --queues=graphrag_tasks
# QA: KB_PROCESS_ROLE=qa_import_worker celery -A src.tasks.celery_worker:celery_app worker --pool=prefork --queues=qa_import

# Knowledge business environment variables.
MAX_FILE_SIZE=52428800
MAX_CHUNK_BATCH_SIZE=8
