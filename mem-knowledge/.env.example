# Knowledge service environment variables.
KB_HOST=0.0.0.0
KB_PORT=8080
KB_PROCESS_ROLE=api
KB_LOG_LEVEL=INFO

# Knowledge-owned database pools.
KB_DB_POOL_SIZE=20
KB_DB_MAX_OVERFLOW=10
KB_DB_POOL_RECYCLE=1800
KB_DB_POOL_TIMEOUT=30
KB_DB_POOL_PRE_PING=true
KB_DB_STATEMENT_TIMEOUT_MS=60000

# Service-local client limits.
KB_REDIS_POOL_SIZE=50
KB_ES_CONNECTIONS_PER_NODE=10
KB_VISION_MAX_WORKERS=10
KB_HEALTH_PROBE_TIMEOUT_SECONDS=3
EMBEDDING_MAX_WORKERS=3
AUTO_QUESTIONS_MAX_WORKERS=5
KNOWLEDGE_GRAPH_EXTRACT_MAX_CONCURRENCY=4

# Parser services. MinerU and TextLn failures do not fall back to another parser.
MAX_DOCUMENT_PAGES=200
MINERU_V3_APISERVER=http://127.0.0.1:18000
MINERU_V3_REQUEST_TIMEOUT_SECONDS=600
MINERU_V3_POLL_INTERVAL_SECONDS=2
MINERU_V3_POLL_TIMEOUT_SECONDS=1800
TEXTLN_APISERVER=https://api.textin.com/ai/service/v1/pdf_to_markdown
TEXTLN_APP_ID=
TEXTLN_SECRET_CODE=
TEXTLN_REQUEST_TIMEOUT_SECONDS=600

# Office and legacy .doc runtime artifacts.
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TIMEOUT_SECONDS=120
TIKA_SERVER_JAR=file:///opt/tika/tika-server-standard-3.1.0.jar

# Public file URL prefix used in generated image Markdown. Empty keeps relative URLs.
FILE_LOCAL_SERVER_URL=

# Audio and video model. The API key is intentionally blank by default.
QWEN3_OMNI_API_KEY=
QWEN3_OMNI_MODEL_NAME=qwen3-omni-flash
QWEN3_OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Worker defaults. Deployment commands override concurrency and queue.
KB_WORKER_PREFETCH_MULTIPLIER=1
KB_TASK_TIME_LIMIT_SECONDS=3600
KB_TASK_SOFT_TIME_LIMIT_SECONDS=3000
KB_RESULT_EXPIRES_SECONDS=3600

# Knowledge business environment variables.
# Add migrated A3/A4/A5 business variables in grouped KB_* sections below.
