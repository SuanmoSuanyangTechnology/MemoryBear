# Knowledge service process settings.
MEM_KNOWLEDGE_HOST=0.0.0.0
MEM_KNOWLEDGE_PORT=8080
MEM_KNOWLEDGE_PROCESS_ROLE=api
MEM_KNOWLEDGE_LOG_LEVEL=INFO

# Knowledge-owned database pools.
MEM_KNOWLEDGE_DB_POOL_SIZE=20
MEM_KNOWLEDGE_DB_MAX_OVERFLOW=10
MEM_KNOWLEDGE_DB_POOL_RECYCLE=1800
MEM_KNOWLEDGE_DB_POOL_TIMEOUT=30
MEM_KNOWLEDGE_DB_POOL_PRE_PING=true
MEM_KNOWLEDGE_DB_STATEMENT_TIMEOUT_MS=60000

# Service-local client limits.
MEM_KNOWLEDGE_REDIS_POOL_SIZE=50
MEM_KNOWLEDGE_ES_CONNECTIONS_PER_NODE=10
MEM_KNOWLEDGE_HEALTH_PROBE_TIMEOUT_SECONDS=3

# Worker defaults. Deployment commands override concurrency and queue.
MEM_KNOWLEDGE_WORKER_PREFETCH_MULTIPLIER=1
MEM_KNOWLEDGE_TASK_TIME_LIMIT_SECONDS=3600
MEM_KNOWLEDGE_TASK_SOFT_TIME_LIMIT_SECONDS=3000
MEM_KNOWLEDGE_RESULT_EXPIRES_SECONDS=3600
