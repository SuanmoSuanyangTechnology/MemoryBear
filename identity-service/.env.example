# ============================================
# identity-service 环境变量模板（部署填值用）
# K8s 部署：拆入 k8s/configmap.yaml（非敏感）与 k8s/secret.yaml（敏感），经 envFrom 注入
# 本地开发：config.py 在 import 时 load_dotenv() 向上查找根 .env，本文件仅供部署参考
# ============================================

# ---- PostgreSQL（core 表只读访问 + 审计落库）----
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# ---- Redis（快照写入 + 审计队列消费 + pub/sub）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# ---- 内部 token（决策 #15 注入模式，与 gateway 两侧值必须一致）----
# uv run python scripts/gen_internal_keypair.py 生成，缺失启动即报错
# 轮换不做代码侧叠加窗口：K8s Secret 变更 + 部署重启承载，旧 token 随 TTL 过期
INTERNAL_ISSUER_PRIVATE_KEY=
INTERNAL_ISSUER_KID=

# ---- 服务自身 ----
RECONCILE_INTERVAL_SEC=60
# 失效通知频道（与老单体 publisher 一致）：留空则按 auth:invalidations:<DB_NAME>
# 派生，隔离共用同一 Redis 的不同环境
AUTH_INVALIDATION_CHANNEL=
# ACL 规则 key + 热更新频道（与 gateway 模式服务一致）：留空则按
# acl:rules:<DB_NAME> / acl:rules:changed:<DB_NAME> 派生，隔离共用同一 Redis
# 的不同环境（pub/sub 频道不受 Redis logical DB 隔离，频道同样需要命名空间）
ACL_RULES_KEY=
ACL_RULES_CHANGED_CHANNEL=
# 审计 Stream（gateway XADD，identity 消费组批量落库；event_id 幂等）：
# 留空则按 audit:stream:<DB_NAME> 派生，隔离共用同一 Redis 的不同环境
# （共享 stream 会让消费组把事件分流到别的环境落库）
AUDIT_STREAM_KEY=
# 审计保留（天）：0 禁用清理；设计 §7 要求 append-only 审计流 ≥180 天
AUDIT_RETENTION_DAYS=180
AUDIT_RETENTION_INTERVAL_SEC=3600

# ---- 管理面同步 Redis 连接池 ----
REDIS_POOL_SIZE=100

# ---- JWT / 会话语义（名称、取值默认值必须与老单体 core/api/app/core/config.py 一致）----
# 切流与回滚期间两侧同时签发/验签，SECRET_KEY 必须与老单体、gateway 完全相同
# 留空则沿用代码默认值，仅供本地开发；生产必须显式填值
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_SINGLE_SESSION=false
ENABLE_SINGLE_WORKSPACE=true

# ---- SMTP（同步 smtplib：邮箱验证码与邀请邮件）----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- 首超管 bootstrap（POST /api/setup，仅在无超管时生效）----
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=

# ---- 运行环境 ----
ENVIRONMENT=development

# ---- i18n ----
I18N_DEFAULT_LANGUAGE=zh
I18N_SUPPORTED_LANGUAGES=zh,en

# ---- 日志敏感字段过滤（与老单体同名同默认）----
ENABLE_SENSITIVE_DATA_FILTER=true

# ---- 出站 model-service（空间模型选择校验）----
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8080
MODEL_SERVICE_CONNECT_TIMEOUT_SECONDS=5
MODEL_SERVICE_READ_TIMEOUT_SECONDS=120

# ---- 出站 memory-profile（W2-B：重算任务登记与在途任务查询）----
# identity 先提交 workspaces 模型列，再调 jobs 接口登记重算任务；接口只做库内
# 操作（解析模型名、落 job 行、派发、缓存失效），非 2xx 时 identity 回滚列并原样
# 转发该响应；登记成功后在途任务 id 回填 reembed_job_id（GET 查询失败降级 null）。
MEMORY_PROFILE_BASE_URL=http://127.0.0.1:8082
MEMORY_PROFILE_CONNECT_TIMEOUT_SECONDS=5
MEMORY_PROFILE_READ_TIMEOUT_SECONDS=30

# ---- Celery 生产端（identity 只发布任务，由 notification-service 消费）----
# 留空则按 REDIS_HOST/REDIS_PORT/REDIS_DB_CELERY_BROKER 派生 redis:// URL
CELERY_BROKER_URL=
REDIS_DB_CELERY_BROKER=3
