# ============================================
# identity-service 环境变量模板（部署填值用）
# K8s 部署：拆入 k8s/configmap.yaml（非敏感）与 k8s/secret.yaml（敏感），经 envFrom 注入
# 本地开发：config.py 在 import 时 load_dotenv() 向上查找根 .env，本文件仅供部署参考
# ============================================

# ---- PostgreSQL（core 表只读访问 + 审计落库）----
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# ---- Redis（快照写入 + 审计队列消费 + pub/sub）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- 内部 token（决策 #15 注入模式，与 gateway 两侧值必须一致）----
# uv run python scripts/gen_internal_keypair.py 生成，缺失启动即报错
# 轮换不做代码侧叠加窗口：K8s Secret 变更 + 部署重启承载，旧 token 随 TTL 过期
INTERNAL_ISSUER_PRIVATE_KEY=
INTERNAL_ISSUER_KID=

# ---- 服务自身 ----
RECONCILE_INTERVAL_SEC=60
# 审计：老单体 list 队列（兼容存量，排空即停）+ 新写入 Stream（CG + event_id 幂等）
AUDIT_QUEUE_KEY=audit:queue
AUDIT_STREAM_KEY=audit:stream
# 审计保留（天）：0 禁用清理；设计 §7 要求 append-only 审计流 ≥180 天
AUDIT_RETENTION_DAYS=180
AUDIT_RETENTION_INTERVAL_SEC=3600

# 注意：identity 不读 SECRET_KEY（不验签用户 JWT，只做快照组装与审计）
