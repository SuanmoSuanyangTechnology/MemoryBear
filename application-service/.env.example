# Application service environment variables. Root .env is loaded first, then
# this file, then the process environment — later sources win (bootstrap.load_settings).
APPLICATION_SERVICE_HOST=0.0.0.0
APPLICATION_SERVICE_PORT=8080
APPLICATION_SERVICE_LOG_LEVEL=INFO

# Application-service-owned database pools. Shared DB_HOST/DB_* below point at
# the same database as the host api service — the 39 app-domain tables are
# shared during the coexistence period; schema is managed by the monolith
# migration chain only (this service has no migration chain).
APPLICATION_SERVICE_DB_POOL_SIZE=20
APPLICATION_SERVICE_DB_MAX_OVERFLOW=10
APPLICATION_SERVICE_DB_POOL_RECYCLE=1800
APPLICATION_SERVICE_DB_POOL_TIMEOUT=30
APPLICATION_SERVICE_DB_POOL_PRE_PING=true
APPLICATION_SERVICE_DB_STATEMENT_TIMEOUT_MS=60000

# Service-local client limits.
APPLICATION_SERVICE_REDIS_POOL_SIZE=50
APPLICATION_SERVICE_HEALTH_PROBE_TIMEOUT_SECONDS=3

# Namespace for this service's own Redis keys (the instance is shared with the
# monolith's broker/cache during the coexistence period).
APPLICATION_SERVICE_REDIS_KEY_PREFIX=app:

# SSE contract (no SSE endpoint exists yet; contract defined here once).
# The service must heartbeat / close strictly before the gateway's 300s idle
# cutoff: idle must stay < 300s and the heartbeat interval below the idle value.
APPLICATION_SERVICE_SSE_IDLE_TIMEOUT_SECONDS=90
APPLICATION_SERVICE_SSE_HEARTBEAT_INTERVAL_SECONDS=30

# Shared environment variables.
DEPLOYMENT_MODE=community
ENVIRONMENT=development
ENABLE_SENSITIVE_DATA_FILTER=true
I18N_DEFAULT_LANGUAGE=zh
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=redbear-mem
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Must match the host api's Redis DB — the shared key is acl:rules
# (identity-written, gateway-mode ACL source).
REDIS_DB=0
# Usage-event stream. Leave empty to derive model:usage:<DB_NAME> so deployments
# sharing one Redis but owning separate databases stay isolated; set explicitly
# only when those deployments share a database name as well.
MODEL_USAGE_STREAM=

# Internal-face auth. direct = community default: the service trusts the
# X-App-* identity headers injected by the gateway after terminating
# credentials; credentials are neither verified nor consumed — the security
# boundary is the NetworkPolicy admitting only the gateway pod and probes.
# Missing identity headers → 401 fail-closed. gateway = enterprise:
# internal-token verification through the private enterprise-extensions
# package, which must be installed — a missing package is a startup error.
# Deployment order is a hard constraint: provision the service's ACL rules
# through identity /internal/acl-rules BEFORE switching to gateway mode.
APPLICATION_SERVICE_AUTH_MODE=direct
APPLICATION_SERVICE_INTERNAL_NAME=application-service
# Used by gateway mode only; points at identity /jwks.
# APPLICATION_SERVICE_JWKS_URL=
# Deployment-scoped ACL rule key/channel (gateway mode only). Empty derives
# acl:rules:<DB_NAME> / acl:rules:changed:<DB_NAME>; must match identity.
# ACL_RULES_KEY=
# ACL_RULES_CHANGED_CHANNEL=

# Monolith upstream channel (coexistence period). Cross-domain writes and the
# context-engine / long-term-memory delegations forward to the monolith's
# internal callback endpoints (never through the gateway). Authentication is a
# dedicated shared secret configured on both ends (generate 32 random bytes;
# never reuse SECRET_KEY or any platform credential); unset or unreachable
# channels fail the delegated paths closed.
# APPLICATION_SERVICE_UPSTREAM_BASE_URL=http://api:8000
# APPLICATION_SERVICE_CALLBACK_SECRET=
# APPLICATION_SERVICE_UPSTREAM_TIMEOUT_SECONDS=30
# Independent sandbox service (core/sandbox-service): code-interpreter,
# terminal and sandbox-file builtin tools. Unrelated to the legacy code-node
# sandbox (SANDBOX_URL / SANDBOX_API_KEY). When disabled the tools
# return an explicit "not enabled" error; an enabled but unreachable service
# fails the tool call closed (never executes locally).
ENABLE_SANDBOX_SERVICE=false
SANDBOX_SERVICE_BASE_URL=
# Must match sandbox-service SANDBOX_API_TOKEN (at least 16 characters).
SANDBOX_SERVICE_API_TOKEN=
SANDBOX_SERVICE_CONNECT_TIMEOUT_SECONDS=5
SANDBOX_SERVICE_POOL_TIMEOUT_SECONDS=5
# Server-side hard cap is 300s per execution, plus queuing / first-instance
# creation headroom; must exceed the sandbox single-execution limit.
SANDBOX_SERVICE_READ_TIMEOUT_SECONDS=330
SANDBOX_SERVICE_WRITE_TIMEOUT_SECONDS=30
SANDBOX_SERVICE_MAX_CONNECTIONS=100
SANDBOX_SERVICE_HEALTH_TIMEOUT_SECONDS=3

# Artifact egress (publish to platform storage) / user-file ingress (push into
# the sandbox) limits, enforced by this service. Per-file cap in bytes.
SANDBOX_FILE_MAX_BYTES=104857600
# Per-publish cumulative cap in bytes.
SANDBOX_FILE_MAX_TOTAL_BYTES=209715200
# Allowed extensions (comma separated, leading dot, case-insensitive);
# macro-enabled Office and executables are always rejected.
SANDBOX_FILE_ALLOWED_EXTENSIONS=.pptx,.docx,.xlsx,.pdf,.csv,.txt,.md,.json,.png,.jpg,.jpeg,.gif,.webp,.svg,.zip,.ppt,.doc,.xls

# Max calls of each single tool within one Agent run. One knob for every Agent
# kind (agent app, sub-agent, cluster supervisor, workflow agent node). 1-100.
AGENT_TOOL_CALL_LIMIT=5

# model-service 东西向地址（Agent/工作流调模型必填，须为绝对 http(s) URL，不带 query/fragment）
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8082
