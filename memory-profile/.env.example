# ============================================
# memory-profile 环境变量模板（部署填值用）
# K8s 部署：拆入 k8s/configmap.yaml（非敏感）与 k8s/secret.yaml（敏感），经 envFrom 注入
# 本地开发：config.py 在 import 时 load_dotenv() 读取服务根 .env
# ============================================

# ---- PostgreSQL（core 表只读 + 分析）----
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# ---- Elasticsearch（记忆检索后端）----
ELASTICSEARCH_HOST=
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=False
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=100000
ELASTICSEARCH_RETRY_ON_TIMEOUT=True
ELASTICSEARCH_MAX_RETRIES=10

# ---- HTTP client ----
HTTP_MAX_CONNECTIONS=100
HTTP_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=30
# SSRF 出站代理（可选）
#HTTP_SSRF_PROXY=

# ---- Logging ----
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO
LOG_FORMAT='%(asctime)s - [%(trace_id)s] - %(name)s - %(levelname)s - %(message)s'
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# ---- Neo4j（记忆系统图数据库）----
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_MAX_POOL_SIZE=30
NEO4J_ACQ_TIMEOUT=30.0
NEO4J_MAX_CONN_LIFETIME=3600
NEO4J_CONN_TIMEOUT=30.0

# ---- Redis（gateway 模式 ACL 规则来源，与 identity 同库）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=100

# ---- Auth（对齐 mem-knowledge 评审稿 4.3 双模式）----
# direct（缺省）= 社区版：本地 HS256 验签 JWT / API key 走 identity 集中校验
# gateway = 企业版：内部 token 验签 + ACL（需 enterprise-extensions，未装 → 启动期 RuntimeError）
MEMORY_AUTH_MODE=direct
# 内部 token 受众 = 目标服务名，须与网关 routes.json 的 aud 一致
MEMORY_SERVICE_NAME=memory
# direct 模式 JWT 验签密钥（HS256），须与老单体 SECRET_KEY 同源
#MEMORY_SECRET=
# gateway 模式内部 token 公钥 JWKS 端点（RS256，与网关 INTERNAL_ISSUER_KID 对应）
#MEMORY_JWKS_URL=
# 应急开关：文件存在即绕过鉴权（仅灰度窗口期）
#MEMORY_KILL_SWITCH_FILE=
# direct 模式 API key 集中校验端点（identity POST /internal/api-key-verify）
#MEMORY_API_KEY_VERIFY_URL=

# ---- Memory read backend ----
MEMORY_READ_BACKEND=ELASTIC

# ---- i18n（响应消息多语言，见 src/i18n/ 与 locales/README.md）----
# 默认语言 / 缺翻译时的兜底语言
I18N_DEFAULT_LANGUAGE=zh
I18N_FALLBACK_LANGUAGE=zh
# 受支持语言（逗号分隔）；请求语言不在列表内即改判为默认语言
I18N_SUPPORTED_LANGUAGES=zh,en
# core 翻译目录（缺省 <服务根>/locales，通常无需设置）
#I18N_CORE_LOCALES_DIR=
# 企业版覆盖目录（可选）：同名命名空间深度合并，premium 覆盖 core
#I18N_PREMIUM_LOCALES_DIR=
I18N_ENABLE_TRANSLATION_CACHE=true
I18N_LRU_CACHE_SIZE=1000
# 缺翻译时打 warning（排查漏翻时开，生产可关以免噪音）
I18N_LOG_MISSING_TRANSLATIONS=true
