# Service
PROFILE_HOST=0.0.0.0
PROFILE_PORT=8082
PROFILE_LOG_LEVEL=INFO
PROFILE_LOG_FORMAT=text
PROFILE_ACCESS_LOG_ENABLED=true
PROFILE_HEALTH_PROBE_TIMEOUT_SECONDS=2

# Runtime monitoring: tracemalloc is opt-in because allocation tracing has
# measurable CPU/memory overhead. Restart after changing it.
PROFILE_MEMORY_TRACEMALLOC_ENABLED=false
PROFILE_MEMORY_TRACEMALLOC_FRAMES=10
# 0 disables the RSS warning; otherwise a byte threshold for status=degraded.
PROFILE_MEMORY_RSS_WARN_BYTES=0

# Response localization: X-Language-Type, then Accept-Language, then the default.
# Locale catalogs ship under src/locales; list every shipped locale here.
I18N_DEFAULT_LANGUAGE=zh
I18N_FALLBACK_LANGUAGE=zh
I18N_SUPPORTED_LANGUAGES=zh,en
# I18N_LOCALES_DIR=/app/src/locales

# Service-to-service authentication
# direct: trust the generic identity headers (x-user-id / x-tenant-id / x-workspace-id)
# from an isolated API/Gateway network
# gateway: verify Bearer internal JWT through enterprise_ext.memory
MEMORY_AUTH_MODE=direct
MEMORY_AUTH_SERVICE_NAME=memory-profile
MEMORY_AUTH_KILL_SWITCH_FILE=
MEMORY_AUTH_JWKS_URL=
# ACL rule key + hot-reload channel (gateway mode only): empty derives
# acl:rules:<DB_NAME> / acl:rules:changed:<DB_NAME> to match the identity
# service's write side, so deployments sharing one Redis stay isolated.
ACL_RULES_KEY=
ACL_RULES_CHANGED_CHANNEL=

# Model service invoke face (LLM generation: insight / summary / interest).
# Credentials and channel failover stay in the model service.
MODEL_SERVICE_BASE_URL=http://model-service:8080
MODEL_SERVICE_INVOKE_CONNECT_TIMEOUT_SECONDS=5
MODEL_SERVICE_INVOKE_IDLE_TIMEOUT_SECONDS=180
MODEL_SERVICE_INVOKE_WRITE_TIMEOUT_SECONDS=60
MODEL_SERVICE_POOL_TIMEOUT_SECONDS=5
MODEL_SERVICE_MAX_CONNECTIONS=100
MODEL_SERVICE_MAX_KEEPALIVE_CONNECTIONS=20
PROFILE_INTEREST_CACHE_EXPIRE_SECONDS=86400

PROFILE_DATABASE_POOL_SIZE=5
PROFILE_DATABASE_WRITE_POOL_SIZE=2
PROFILE_DATABASE_WRITE_MAX_OVERFLOW=3
PROFILE_DATABASE_MAX_OVERFLOW=5
PROFILE_DATABASE_POOL_TIMEOUT_SECONDS=30
PROFILE_DATABASE_POOL_RECYCLE_SECONDS=1800
PROFILE_REDIS_POOL_SIZE=100
PROFILE_ELASTICSEARCH_CONNECTIONS_PER_NODE=20

# Shared PostgreSQL schema (owned by api migrations)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=memorybear
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/memorybear
# Optional DDL-role URL used only by Alembic; falls back to DATABASE_URL/settings above.
# PROFILE_MIGRATION_DATABASE_URL=postgresql+asyncpg://profile_migrator:change-me@postgres:5432/memorybear

# Shared Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_MAX_POOL_SIZE=30
NEO4J_ACQ_TIMEOUT=30
NEO4J_MAX_CONN_LIFETIME=3600
NEO4J_CONN_TIMEOUT=30
# NEO4J_DATABASE=neo4j

# Shared Redis
# Must match the API's Redis logical DB so workspace_statistics snapshots
# produced by the API worker are visible to this service (API uses DB 3).
REDIS_URL=redis://redis:6379/3

# Shared Elasticsearch
ELASTICSEARCH_HOST=https://elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=120
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_RETRIES=10
