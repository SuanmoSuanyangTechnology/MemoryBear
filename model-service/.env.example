# Model service environment variables. Root .env is loaded first, then this file,
# then the process environment — later sources win (bootstrap.load_settings).
MODEL_SERVICE_HOST=0.0.0.0
MODEL_SERVICE_PORT=8080
MODEL_SERVICE_LOG_LEVEL=INFO

# Model-service-owned database pools. Shared DB_HOST/DB_* below point at the same
# database as the host api service — model_configs/model_bases/model_channels/
# model_usage_records are written only here.
MODEL_SERVICE_DB_POOL_SIZE=20
MODEL_SERVICE_DB_MAX_OVERFLOW=10
MODEL_SERVICE_DB_POOL_RECYCLE=1800
MODEL_SERVICE_DB_POOL_TIMEOUT=30
MODEL_SERVICE_DB_POOL_PRE_PING=true
MODEL_SERVICE_DB_STATEMENT_TIMEOUT_MS=60000

# Service-local client limits.
MODEL_SERVICE_REDIS_POOL_SIZE=50
MODEL_SERVICE_HEALTH_PROBE_TIMEOUT_SECONDS=3

# Runtime invoke budgets. First-result is per candidate (timeout → transient error →
# in-place retry → channel switch); total is per request (must stay below the host's
# invoke idle budget, and be at least 3x the first-result budget).
# The llm family overrides both (生成整段回复天然慢): a slow-response timeout there has
# no room for retry/channel switch, while fast failures still fail over completely.
# For llm streams the llm total budget covers only resolve + first chunk (draining is
# outside it), and the idle budget bounds the gap between chunks service-side.
MODEL_INVOKE_FIRST_RESULT_TIMEOUT_S=15
MODEL_INVOKE_TOTAL_TIMEOUT_S=45
MODEL_INVOKE_LLM_FIRST_RESULT_TIMEOUT_S=120
MODEL_INVOKE_LLM_TOTAL_TIMEOUT_S=150
MODEL_INVOKE_LLM_IDLE_TIMEOUT_S=60

# Shared environment variables.
DEPLOYMENT_MODE=community
ENVIRONMENT=development
ENABLE_SENSITIVE_DATA_FILTER=true
I18N_DEFAULT_LANGUAGE=zh
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=redbear-mem
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Must match the host api's Redis DB — shared keys: model:usage stream (host alert
# bridge), acl:rules (identity-written), runtime_model_info invalidation keys.
REDIS_DB=0

# Model channel credential master key (base64 32B). Must be identical to the api
# service's MODEL_CREDENTIALS_KEY — channel credentials are decrypted with it and
# an AAD of provider:tenant_id.
MODEL_CREDENTIALS_KEY=

# Startup sync of the predefined-model YAML seeds (D-M7-5: this service is the
# single writer; the host api's loader call is removed). Keep false on the host.
LOAD_MODEL=false

# Channel selection load statistics (model_usage_records) read window and the
# least-used tie-breaker switch.
MODEL_USAGE_LOAD_WINDOW_MINUTES=15
MODEL_USAGE_LEAST_USED_ENABLED=true
# Backlog warning threshold for the in-process usage consumer (consumer-group
# lag / pending above this value logs a warning). XLEN is not checked: entries
# stay until the publisher's maxlen trim, so stream length grows regardless of
# consumption.
MODEL_USAGE_BACKLOG_WARN=50000

# Channel circuit-breaker cooldown (M9): failed channels (429/401/403/connection
# class) are cooled for this many seconds; 5xx and credential-decrypt failures do
# not cool. Resolution soft-skips cooled channels and releases the whole chain
# when every candidate is cooled.
MODEL_CHANNEL_COOLDOWN_ENABLED=true
MODEL_CHANNEL_COOLDOWN_SECONDS=60

# Provider call parameters shared by liveness validation and availability probes.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_WORKERS=3
MODEL_CONCURRENCY=5
MODEL_HTTP_MAX_CONNECTIONS=300
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
MODEL_HTTP_TRUST_ENV=true
BEDROCK_MAX_POOL_CONNECTIONS=50
BEDROCK_MAX_RETRIES=2

# SpeedBear (enterprise platform admin) call settings.
SPEEDBEAR_BASE_URL=https://testspeedbear.redbearai.com
SPEEDBEAR_AUTH_KEY=

# Internal-face auth. direct = community default: the service trusts the
# X-Model-* identity headers injected by the upstream (the gateway in split
# deployments after terminating credentials, the host proxy in legacy wiring);
# credentials are neither verified nor consumed — the security boundary is the
# NetworkPolicy admitting only the gateway + host proxy pods. Missing identity
# headers → 401 fail-closed. gateway = enterprise: internal-token verification
# through the private enterprise-extensions package, which must be installed —
# a missing package is a startup error (misconfiguration fails loudly).
MODEL_SERVICE_AUTH_MODE=direct
MODEL_SERVICE_INTERNAL_NAME=model-service
# Used by gateway mode only; points at identity /jwks.
# MODEL_SERVICE_JWKS_URL=
