# E2B Orchestrator Configuration
# 复制此文件为 .env 并修改
#
# 注意：docker-compose 从同级目录的 .env 文件读取变量。
# 容器内访问宿主机 Redis 需要用 host.docker.internal (macOS/Windows)
# 或宿主机 IP (Linux)。

# Redis 连接（复用项目已有的 Redis）
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
ORCHESTRATOR_REDIS_DB=10

# Orchestrator
E2B_ORCHESTRATOR_PORT=3001
E2B_ORCHESTRATOR_SECRET=changeme
ORCHESTRATOR_LOG_LEVEL=info

# Docker hosts（逗号分隔多个 host）
ORCHESTRATOR_DOCKER_HOSTS=unix:///var/run/docker.sock

# Sandbox 默认配置
E2B_TEMPLATE_REGISTRY=
E2B_TEMPLATE_ID=agent-runtime
E2B_SANDBOX_TIMEOUT=300
ORCHESTRATOR_MAX_SANDBOXES=50
E2B_SANDBOX_MEMORY_MB=512
E2B_SANDBOX_CPU=2
E2B_WARM_POOL_SIZE=2
