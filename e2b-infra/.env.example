# E2B Self-Hosted Infrastructure Configuration
# 复制此文件为 .env 并修改

# Redis password for E2B state storage
REDIS_PASSWORD=e2b_redis_pass

# Secret for authenticating API requests to orchestrator
E2B_ORCHESTRATOR_SECRET=your-secure-secret-here

# Maximum number of concurrent sandboxes
MAX_SANDBOXES=50

# Default sandbox timeout in seconds (5 minutes)
DEFAULT_SANDBOX_TIMEOUT=300

# Maximum sandbox timeout in seconds (1 hour)
MAX_SANDBOX_TIMEOUT=3600

# Callback hosts allowed (comma-separated, * for all)
CALLBACK_ALLOWED_HOSTS=*

# Log level: debug, info, warn, error
LOG_LEVEL=info
