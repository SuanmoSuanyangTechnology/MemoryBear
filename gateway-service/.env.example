# ============================================
# gateway-service 环境变量模板（部署填值用）
# K8s 部署：拆入 k8s/configmap.yaml（非敏感）与 k8s/secret.yaml（敏感），经 envFrom 注入
# 本地开发：config.py 在 import 时 load_dotenv() 向上查找根 .env，本文件仅供部署参考
# ============================================

# ---- 必填（缺失即功能不可用）----
# 用户 JWT 验签密钥（HS256），必须与老单体同源
SECRET_KEY=
# 内部 token 签发密钥（RS256）：由 identity-service/scripts/gen_internal_keypair.py 生成
# （cd ../identity-service && uv run python scripts/gen_internal_keypair.py）；
# gateway 与 identity 读同一变量，两侧值必须一致（决策 #15 注入模式，缺失启动即报错）
INTERNAL_ISSUER_PRIVATE_KEY=
INTERNAL_ISSUER_KID=

# ---- Redis（用户快照 + 审计队列）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CMD_TIMEOUT_MS=500

# ---- 内部 token 签发（本地 RS256）----
INTERNAL_TOKEN_TTL=120
INTERNAL_TOKEN_LEEWAY=30

# ---- 鉴权策略与转发（部署必填，缺省值仅保证能起）----
# direct（缺省）= 社区版透传凭据给下游自验；gateway = 企业插件终结凭据签发内部 token
# （AUTH_STRATEGY=gateway 而 enterprise-extensions 未装 → 启动即 RuntimeError，响亮暴露）
AUTH_STRATEGY=direct
# 转发路由表（无默认；缺省/为空则任何请求都无转发目标）：JSON 完整示例见
# docker-compose.enterprise.yml 的 TARGET_ROUTES（K8s 部署拆入 configmap.yaml）
TARGET_ROUTES={"routes":[{"path_prefix":"/api/knowledges","service":"kb","base_url":"http://kb:8080","aud":"kb"}]}
# 用户路径固定窗口限流（60s 窗口；企业 gateway 策略消费，Redis 故障旁路放行）
USER_RATE_LIMIT_PER_MINUTE=600

# ---- 服务自身 ----
# 审计入队 Stream（identity 消费者 XREADGROUP + event_id 幂等落库）
AUDIT_STREAM_KEY=audit:stream
# 凭据类型判定路径前缀（逗号分隔）：命中前缀 → API key 路径，其余 → 用户 JWT 路径
API_KEY_PATH_PREFIXES=/v1/

# 注意：gateway 不读 DB_*（快照全部来自 Redis，fail-closed 不回源 DB）
