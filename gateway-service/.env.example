# ============================================
# gateway-service 环境变量模板（部署填值用）
# K8s 部署：拆入 k8s/configmap.yaml（非敏感）与 k8s/secret.yaml（敏感），经 envFrom 注入
# 本地开发：config.py 在 import 时 load_dotenv() 向上查找根 .env，本文件仅供部署参考
# ============================================

# ---- 必填（缺失即功能不可用）----
# 用户 JWT 验签密钥（HS256），必须与老单体同源
SECRET_KEY=
# 内部 token 签发密钥（RS256；仅 gateway 档签发用，direct 档不签发也不校验该值）：
# 由 identity-service/scripts/gen_internal_keypair.py 生成；gateway 与 identity 读同一
# 变量，两侧值必须一致（决策 #15 注入模式）
INTERNAL_ISSUER_PRIVATE_KEY=
INTERNAL_ISSUER_KID=

# ---- Redis（用户快照 + 黑名单/限流键 + 审计队列）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CMD_TIMEOUT_MS=500

# ---- 内部 token 签发（本地 RS256；仅 gateway 档消费）----
INTERNAL_TOKEN_TTL=120
INTERNAL_TOKEN_LEEWAY=30

# ---- 鉴权策略与转发（部署必填，缺省值仅保证能起）----
# direct（缺省）= 社区版在网关终结凭据：验签用户 JWT → Redis 用户快照/黑名单判定
#   （fail-closed；快照由 identity-service 维护）→ user 级限流 → 剥凭据 → 注入身份头，
#   不签发内部 token（下游信注入头）；/v1/ API key 路径同样在网关做快照 + QPS/日配额判定。
# gateway = 企业插件跑同一条终结流水线（src/termination.py 共享）并追加签发内部 token，
#   另须 identity /jwks 与 Redis acl:rules（AUTH_STRATEGY=gateway 而 enterprise-extensions
#   未装 → 启动即 RuntimeError，响亮暴露）
AUTH_STRATEGY=direct
# 转发路由表（本仓库 routes.json 为镜像内置默认，Dockerfile COPY → 容器
# /etc/gateway/routes.json，裸部署开箱即用；compose bind-mount / K8s ConfigMap
# 挂载同一路径覆盖镜像默认。新增服务只改该文件）。优先级：
#   TARGET_ROUTES_FILE（显式指向，缺失/非法 JSON → 启动 RuntimeError 响亮失败）
#   > TARGET_ROUTES env（旧行为兜底）> 镜像内置 /etc/gateway/routes.json > 空路由
# API key 范围门禁：/v1/ 路由必须显式声明 required_scopes（all-of，语义同老单体
# @require_api_key：kb=/rag、app=/app、end_user=/memory）；未声明或 key 缺 scope
# → 403 fail-closed。/api/ 为用户 JWT 路径，无需声明。
TARGET_ROUTES_FILE=/etc/gateway/routes.json
# env 兜底（未配 TARGET_ROUTES_FILE 时生效；缺省/为空 = 空路由，任何请求无转发目标）
TARGET_ROUTES=
# 用户路径固定窗口限流（60s 窗口；direct/gateway 两档共享终结流水线消费，Redis 故障旁路放行）
USER_RATE_LIMIT_PER_MINUTE=600

# ---- 服务自身 ----
# 审计入队 Stream（identity 消费者 XREADGROUP + event_id 幂等落库）：留空则按
# audit:stream:<DB_NAME> 派生，须与 identity 同名；两者都为空则启动 fail-fast
DB_NAME=
AUDIT_STREAM_KEY=
# Stream 长度近似上限（XADD MAXLEN ~）：消费者滞后时兜底 Redis 内存，超出丢最旧事件；
# 长期审计保留以 identity 落库的 audit_logs 为准（≥180 天）
AUDIT_STREAM_MAXLEN=500000
# 凭据类型判定路径前缀（逗号分隔）：命中前缀 → API key 路径，其余 → 用户 JWT 路径
API_KEY_PATH_PREFIXES=/v1/
# API key 快照 miss 回源（identity 是凭据权威；存量 key 无快照时懒回填）：
# 留空 = 关闭回源，miss 即 401；集群内指向
# http://identity-service:8001/internal/api-key-verify
IDENTITY_API_KEY_VERIFY_URL=
IDENTITY_API_KEY_VERIFY_TIMEOUT_MS=500
# 无效 key 负缓存 TTL（秒）：identity 明确 401 后短期不再回源；0 = 关闭
API_KEY_MISS_CACHE_TTL_SECONDS=30
# /stub、/v1/stub 回显注入身份头与内部 token，仅供 e2e/单测；生产必须保持 false
ENABLE_STUB_ENDPOINTS=false

# ---- 东西向 gRPC（网关 → 应用 chat）----
# 留空 = 跟随路由表 protocol 字段（缺省 http）；取值 http/grpc，其他值启动即 RuntimeError。
# 回滚 = 改回 http（或清空）+ 触发滚动：路由表仅启动时读取一次，不支持热加载。
GATEWAY_APP_CHAT_PROTOCOL=
APPLICATION_SERVICE_GRPC_TARGET=dns:///application-service-grpc:9090
# 单次 chat 流总截止（秒）；客户端断开即取消上游流
GATEWAY_GRPC_DEADLINE_S=3600
GRPC_MAX_MESSAGE_BYTES=67108864
GRPC_KEEPALIVE_TIME_MS=30000
GRPC_KEEPALIVE_TIMEOUT_MS=10000
GRPC_SHUTDOWN_GRACE_S=20
# 流式并发上限（HTTP/gRPC 共用同一 gate），触顶返回 503 too many streams
GATEWAY_STREAM_MAX_CONNECTIONS=100
GATEWAY_STREAM_HEARTBEAT_S=30
GATEWAY_STREAM_IDLE_TIMEOUT_S=300

# 注意：gateway 不直连数据库（快照来自 Redis；API key miss 经 identity 内部接口
# 回源重建，其余 miss fail-closed）；DB_NAME 仅用于派生审计 stream 名
