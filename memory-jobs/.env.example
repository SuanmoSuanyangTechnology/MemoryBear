# memory-jobs — Celery worker/beat service
#
# Shared infrastructure values (DATABASE_*, REDIS_*, ELASTICSEARCH_*, NEO4J_*)
# are the same names the API uses, so the root .env can be reused as-is.
# Everything below is optional; defaults match the repository's local defaults.

# Service
JOBS_SERVICE_NAME=memory-jobs
JOBS_LOG_LEVEL=INFO
JOBS_LOG_FORMAT=text

# Probe PostgreSQL / Redis / Elasticsearch / Neo4j once per worker process at
# startup and exit when one is down. Off by default: a transient dependency
# outage should not prevent workers from booting.
JOBS_STARTUP_DEPENDENCY_CHECK=false
# Per-request timeout for dependency probes (readiness probe, health ping).
JOBS_HEALTHCHECK_TIMEOUT_SECONDS=3

# Enterprise service (optional). The closed-source `memory-enterprise` service
# owns the enterprise tables (ontology scene names, ...) and their definitions;
# this worker only asks it over HTTP. Leave the URL empty in the open build: the
# fields that depend on it are skipped (uuid scene keys are dropped), exactly like
# the API without its ontology plugin.
# MEMORY_ENTERPRISE_BASE_URL=http://memory-enterprise:8083
MEMORY_ENTERPRISE_TIMEOUT_SECONDS=3
# MEMORY_ENTERPRISE_TOKEN=change-me

# PostgreSQL (synchronous psycopg driver)
# DATABASE_URL may be given in asyncpg form; it is rewritten to psycopg.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DB_NAME=memorybear
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/memorybear
JOBS_DATABASE_POOL_SIZE=5
JOBS_DATABASE_MAX_OVERFLOW=10
JOBS_DATABASE_POOL_TIMEOUT_SECONDS=30
JOBS_DATABASE_POOL_RECYCLE_SECONDS=1800
JOBS_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Redis (synchronous client, business data)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
# REDIS_URL=redis://:password@redis:6379/1
JOBS_REDIS_POOL_SIZE=100
JOBS_REDIS_SOCKET_TIMEOUT_SECONDS=30
JOBS_REDIS_CONNECT_TIMEOUT_SECONDS=5

# Celery broker and result backend.
# Logical DBs MUST match api/app/core/config.py (broker=3, backend=4) so the
# API's producers and these workers share the same queues.
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_BACKEND=4
# Full overrides (e.g. RabbitMQ). Never export bare BROKER_URL/RESULT_BACKEND:
# Celery's Click CLI claims those names.
# CELERY_BROKER_URL=amqp://user:password@rabbitmq:5672/vhost
# CELERY_RESULT_BACKEND=redis://:password@redis:6379/4
# AMQP x-max-priority for the queues this service declares. RabbitMQ ignores the
# message priority unless the queue carries it, and every app that declares the
# queue (this worker, memory-profile, the API) must use the same value or the
# declaration fails with PRECONDITION_FAILED. Redis brokers ignore it.
JOBS_TASK_QUEUE_MAX_PRIORITY=9
# This service's own queue; every route lands here. The name also lives in the
# shared contract (task_bridge.mem_router.QueueName) that memory-profile installs.
JOBS_TASK_DEFAULT_QUEUE=memory_jobs_tasks
JOBS_TASK_TIME_LIMIT=3600
JOBS_TASK_SOFT_TIME_LIMIT=3000
JOBS_TASK_ACKS_LATE=true
JOBS_TASK_REJECT_ON_WORKER_LOST=true
JOBS_WORKER_PREFETCH_MULTIPLIER=1
JOBS_WORKER_SEND_TASK_EVENTS=true
JOBS_TASK_SEND_SENT_EVENT=true
JOBS_RESULT_EXPIRES=3600
# One result backend (one Redis client + pool) shared by all worker threads.
# Leave true under --pool=threads; set false only to restore Celery's
# thread-local backend behaviour.
JOBS_RESULT_BACKEND_THREAD_SAFE=true

# Nightly scan for stale insight/summary caches (beat entry "profile-cache-scan").
# Names and defaults mirror the API's regenerate-memory-cache entry, so cutting
# the API scanner over needs no new values. Times are UTC.
# Keep this false while the API's own scanner is still running.
JOBS_PROFILE_CACHE_SCAN_ENABLED=true
MEMORY_CACHE_REGENERATION_HOUR=18
MEMORY_CACHE_REGENERATION_MINUTE=0
MEMORY_CACHE_FRESH_HOURS=72
# Candidates per page in a periodic sweep: bounds worker memory on large
# workspaces. 500 matches the API's workspace-statistics scanner.
JOBS_SCAN_PAGE_SIZE=500

# Elasticsearch (synchronous client)
ELASTICSEARCH_HOST=https://127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=120
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_RETRIES=10
JOBS_ELASTICSEARCH_CONNECTIONS_PER_NODE=20

# Neo4j (synchronous driver)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=30
NEO4J_ACQ_TIMEOUT=30
NEO4J_MAX_CONN_LIFETIME=3600
NEO4J_CONN_TIMEOUT=30

# Model service (generation tasks: insight + user summary)
# Same variable names as memory-profile, so both services can share one block.
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8080
MODEL_SERVICE_INVOKE_CONNECT_TIMEOUT_SECONDS=5
MODEL_SERVICE_INVOKE_IDLE_TIMEOUT_SECONDS=180
MODEL_SERVICE_INVOKE_WRITE_TIMEOUT_SECONDS=60
MODEL_SERVICE_POOL_TIMEOUT_SECONDS=5
MODEL_SERVICE_MAX_CONNECTIONS=100
MODEL_SERVICE_MAX_KEEPALIVE_CONNECTIONS=20
