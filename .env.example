# Shared infrastructure configuration for MemoryBear services.
# Service-specific values belong in each service's own .env file.

DEPLOYMENT_MODE=community

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=redbear-mem

# Redis and Celery
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_BACKEND=4
# CELERY_BROKER_URL=amqp://user:password@rabbitmq:5672/vhost
# CELERY_RESULT_BACKEND=redis://:password@redis:6379/4

# Elasticsearch
ELASTICSEARCH_HOST=https://127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=100
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_RETRIES=10

# Storage: local, oss, s3, or minio
STORAGE_TYPE=local
FILE_PATH=/files
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET_NAME=
MINIO_REGION=us-east-1

# Shared model runtime
SPEEDBEAR_BASE_URL=https://testspeedbear.redbearai.com
SPEEDBEAR_AUTH_KEY=
# LiteSkill (MemorySkills) 内部管理接口（运营查看后台调用）
LITESKILL_BASE_URL=http://liteskill:8010
# 必须与 LiteSkill 侧 INTERNAL_ADMIN_TOKEN 一致
LITESKILL_INTERNAL_TOKEN=
LITESKILL_TIMEOUT=10
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=10
MODEL_HTTP_MAX_CONNECTIONS=300
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
MODEL_HTTP_TRUST_ENV=true
