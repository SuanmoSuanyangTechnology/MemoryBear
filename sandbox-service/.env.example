# sandbox-service 配置示例。复制为 .env 后按需修改：cp .env.example .env
# 服务启动时会自动加载同目录的 .env（已存在的真实环境变量优先，不会被覆盖）。
# 未设置的变量使用代码默认值；下面注释掉的行就是默认值。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# 后端：cube（真实 CubeSandbox）| fake（内存假后端，仅测试）
SANDBOX_BACKEND=cube

# 主应用调用本服务用的 Bearer 令牌，至少 16 个字符；必须与主应用的
# SANDBOX_SERVICE_API_TOKEN 一致。生成示例：python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_API_TOKEN=change-me-to-a-random-secret-of-32-chars-or-more

# 创建实例用的模板别名，必须与 cubemastercli 建模板时的 --alias 一致，且状态为 READY
SANDBOX_DEFAULT_TEMPLATE=memorybear-sandbox

# ---------------------------------------------------------------------------
# Cube 后端连接（SANDBOX_BACKEND=cube 时必填前两项）
# ---------------------------------------------------------------------------

# CubeAPI（控制面）
SANDBOX_CUBE_API_URL=http://127.0.0.1:3000
# CubeProxy（数据面入口），host:port，不带协议和路径
SANDBOX_CUBE_PROXY_ADDR=127.0.0.1:80

# 开启 Auth Callback 后 CubeAPI 要求的凭据；不要提交真实值
# SANDBOX_CUBE_API_KEY=
# SANDBOX_CUBE_PROXY_SCHEME=http
# host：向 proxy_addr 发 Host: <端口>-<沙箱>.<domain>；path：用 /sandbox/<沙箱>/<端口>/ 路径
# SANDBOX_CUBE_ROUTE_MODE=host
# SANDBOX_CUBE_DOMAIN=cube.app
# SANDBOX_CUBE_CODE_PORT=49999
# SANDBOX_CUBE_HTTP_TIMEOUT_S=30.0
# SANDBOX_CUBE_CREATE_TIMEOUT_S=120.0
# SANDBOX_CUBE_CONNECT_TIMEOUT_S=5.0
# SANDBOX_CUBE_LIST_LIMIT=1000

# ---------------------------------------------------------------------------
# 容量与准入
# ---------------------------------------------------------------------------

# 本服务可持有的实例总数上限（运行 + 暂停 + 创建中）
# SANDBOX_CAPACITY=50
# 单租户实例硬上限；不设为不限
# SANDBOX_TENANT_CAPACITY=
# 超过该数的租户在淘汰时优先被淘汰；不设为不启用
# SANDBOX_TENANT_SOFT_QUOTA=
# 每个终端用户同时存在的 kernel 数（代码解释器和终端各占一个）
# SANDBOX_MAX_KERNELS_PER_USER=4

# ---------------------------------------------------------------------------
# 生命周期（单位：秒）
# ---------------------------------------------------------------------------

# A：实例空闲多久后暂停
# SANDBOX_IDLE_PAUSE_S=1200
# B：暂停最长保留，到点销毁
# SANDBOX_MAX_RETENTION_S=86400
# C：实例存活上限，到点强制重建
# SANDBOX_ABSOLUTE_LIFETIME_S=86400
# 暂停满多久后才允许被淘汰
# SANDBOX_P_MIN_S=7200
# 会话 kernel 闲置多久后回收（终端 kernel 回收前先杀其后台进程组）；0 为关闭。
# 建议小于 SANDBOX_IDLE_PAUSE_S。回收后代码解释器的变量会丢失
SANDBOX_KERNEL_IDLE_S=900

# ---------------------------------------------------------------------------
# 淘汰与排队
# ---------------------------------------------------------------------------

# SANDBOX_HIGH_WATER=0.9
# SANDBOX_LOW_WATER=0.75
# SANDBOX_EVICT_BATCH_MAX=10
# SANDBOX_QUEUE_WAIT_S=3.0
# SANDBOX_QUEUE_POLL_S=0.05

# ---------------------------------------------------------------------------
# 创建限流
# ---------------------------------------------------------------------------

# 节点级并发创建数
# SANDBOX_CREATE_CONCURRENCY=4
# 每终端用户在窗口内最多创建次数
# SANDBOX_CREATE_MAX_PER_WINDOW=5
# SANDBOX_CREATE_WINDOW_S=60.0

# ---------------------------------------------------------------------------
# 后台任务
# ---------------------------------------------------------------------------

# SANDBOX_ORPHAN_GRACE_S=120.0
# SANDBOX_TOMBSTONE_TTL_S=604800
# SANDBOX_TICK_INTERVAL_S=30.0
# SANDBOX_RECONCILE_INTERVAL_S=300.0

# ---------------------------------------------------------------------------
# 执行与输出
# ---------------------------------------------------------------------------

# 单次执行默认超时与上限（请求只能调低，不能超过上限）
# SANDBOX_EXEC_TIMEOUT_DEFAULT_S=120.0
# SANDBOX_EXEC_TIMEOUT_MAX_S=300.0
# stdout / stderr 各自的字节预算，超出按头尾裁剪
# SANDBOX_STDOUT_MAX_BYTES=1048576
# SANDBOX_STDERR_MAX_BYTES=1048576
# SANDBOX_HEAD_RATIO=0.5

# ---------------------------------------------------------------------------
# 文件带入 / 带出（产物）
# ---------------------------------------------------------------------------

# 产物 id（aid）的 HMAC 签名密钥，至少 16 个字符。多副本部署必须所有副本设成同一个值，
# 否则一个副本签发的 aid 在另一个副本验不过；不设则每次启动随机生成（仅单副本、重启后旧 aid 失效）
# SANDBOX_ARTIFACT_KEY=
# aid 有效期
# SANDBOX_ARTIFACT_TTL_S=3600
# 一次列举最多返回的产物数
# SANDBOX_MAX_ARTIFACTS=100
# 单个文件上传 / 下载的大小上限（字节），默认 100MB
# SANDBOX_MAX_FILE_BYTES=104857600
